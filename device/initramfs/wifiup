#!/bin/sh
# wifiup [arka_isik_kapat=1]: SSV6006 (SV6256P) surucusunu yukler ve wlan0'i kaldirir.
# 11.10.2026: ilk "ip link set wlan0 up" cihazi resetledi ve DRAM korunmadi (guc cokmesi suphesi).
# Bu yuzden: istege bagli arka isik kapatma (PG15 bl_en), kernel mesajlari canli akar (/proc/kmsg),
# her adim /dev/kmsg'e zaman damgasiyla yazilir; 60 sn guvenlik reseti.
BL=${1:-1}
K() { echo "[wifiup] $*" > /dev/kmsg; }
( sleep 60; K "60 sn doldu -> watchdog reset"; devmem 0x020500B4 32 0x16aa0001; devmem 0x020500B8 32 0x16aa0001; devmem 0x020500B0 32 0x14af ) &
G=$!
cat /proc/kmsg &
C=$!
if [ "$BL" = 1 ]; then
	v=$(devmem 0x02000130 32); devmem 0x02000130 32 $((v & ~0x8000)); K "arka isik kapatildi (PG15=0)"
fi
if ! lsmod | grep -q '^ssv6x5x'; then
	K "insmod ssv6006.ko"; insmod /lib/wifi/ssv6006.ko; K "insmod rc=$?"
	sleep 2
fi
K "ip link set wlan0 up"
ip link set wlan0 up; K "ip link up rc=$?"
sleep 4
kill $C $G 2>/dev/null
if [ "$BL" = 1 ]; then
	v=$(devmem 0x02000130 32); devmem 0x02000130 32 $((v | 0x8000)); K "arka isik acildi"
fi
ip addr show wlan0
